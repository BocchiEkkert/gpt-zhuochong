{
  "name": "gpt-miko-pet",
  "version": "0.5.0",
  "description": "Miko · Codex 双形象桌面伙伴",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/model.test.cjs tests/bridge.test.cjs tests/monitor.test.cjs tests/codex.test.cjs tests/pet-layout.test.cjs tests/companion.test.cjs",
    "test:ui": "node --test tests/ui.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "dist:win": "electron-builder --win zip --x64",
    "pack": "electron-builder --dir",
    "postinstall": "node node_modules/electron/install.js",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:linux": "node scripts/build-linux.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "io.mori.gptpet",
    "productName": "Miko GPT Pet",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Miko 桌宠",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "src/windows",
        "to": "windows",
        "filter": [
          "*.ps1"
        ]
      }
    ],
    "toolsets": {
      "wine": "1.0.1"
    },
    "artifactName": "Miko-GPT-Pet-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Miko contributors",
      "desktop": {
        "entry": {
          "Name": "Miko 桌宠",
          "Comment": "Miko Codex desktop companion",
          "StartupWMClass": "gpt-miko-pet"
        }
      },
      "syncDesktopName": true
    }
  },
  "author": "Miko contributors",
  "desktopName": "gpt-miko-pet.desktop"
}
